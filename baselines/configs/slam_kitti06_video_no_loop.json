// WP1 SLAM baselines without loop closing: KITTI 06, mono, color video shipped with pySLAM
// - measures front-end drift only (tracking + local mapping), no loop correction
// - no loop closing = no relocalization in pySLAM -> a tracking loss is final (check the number of poses per run)
// run (repo root): python main_slam_evaluation.py -c baselines/configs/slam_kitti06_video_no_loop.json
{
  "num_threads": 1,                     // runs sequential, no interference
  "number_of_runs_per_dataset": 3,      // SLAM non-deterministic -> mean over runs

  "dataset_type": "VIDEO_DATASET",
  "sensor_type": "mono",
  "dataset_base_path": "data/videos",   // overridden per dataset (template_vars)

  "datasets": [
    {
      "name": "kitti06",
      "settings_path": "settings/KITTI04-12.yaml",   // intrinsics, nFeatures = 2000 (all presets)
      "template_vars": {
        "dataset_base_path": "data/videos/kitti06",
        "dataset_name": "video_color.mp4",
        "timestamps_path": "times.txt"
      }
    }
  ],

  // shared by all presets: loop closing off
  "common_parameters": {
    "config": {
      "GLOBAL_PARAMETERS": {
        "kUseLoopClosing": false
      }
    }
  },

  // only difference between presets: the matcher
  "presets": [
    { "name": "orb2",       "custom_parameters": { "settings": { "FeatureTrackerConfig.name": "ORB2" } } },
    { "name": "superpoint", "custom_parameters": { "settings": { "FeatureTrackerConfig.name": "SUPERPOINT" } } },
    { "name": "lightglue",  "custom_parameters": { "settings": { "FeatureTrackerConfig.name": "LIGHTGLUE" } } }
  ],

  "output_path": "wp1_slam_kitti06_no_loop",   // -> results/eval_<date>/wp1_slam_kitti06_no_loop/
  "saved_trajectory_format_type": "kitti"
}
